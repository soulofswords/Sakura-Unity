.agent-workspace {
    --agent-bg: #1c1423;
    --agent-card: #251b2d;
    --agent-input: #302439;
    --agent-line: #4c354d;
    --agent-ink: #fff0f8;
    --agent-muted: #ccb6c8;
    --agent-accent: #ff9ec8;
    --agent-button: #442b43;
    --agent-user: #4c3349;
    background-color: var(--agent-bg);
    border-color: var(--agent-line);
    border-radius: 0;
    color: var(--agent-ink);
    top: 0;
    right: 0;
    bottom: 0;
    font-size: 13px;
}
.light .agent-workspace {
    --agent-bg: #f9f0f5;
    --agent-card: #fffafc;
    --agent-input: #ffffff;
    --agent-line: #e8d3df;
    --agent-ink: #493443;
    --agent-muted: #785f70;
    --agent-accent: #a13464;
    --agent-button: #f9e2ed;
    --agent-user: #eed6e1;
}
.agent-workspace .agent-navigation {
    width: 208px;
    min-width: 160px;
    padding: 16px 10px;
    background-color: var(--agent-card);
    border-right-width: 1px;
    border-right-color: var(--agent-line);
}
.agent-navigation .card-title { color: var(--agent-accent); margin: 0 10px 16px; font-size: 15px; }
.agent-workspace Button {
    min-height: 33px;
    border-color: var(--agent-line);
    border-radius: 8px;
    padding: 6px 10px;
    background-color: var(--agent-button);
    color: var(--agent-accent);
    font-size: 12px;
    -unity-font-style: normal;
}
.agent-workspace Button:hover, .agent-workspace Button:focus { border-color: var(--agent-accent); }
.agent-navigation Button { margin-bottom: 4px; white-space: normal; -unity-text-align: middle-left; }
.agent-navigation .agent-page { flex-direction: row; align-items: center; padding-left: 37px; background-color: transparent; color: var(--agent-muted); border-color: transparent; min-height: 35px; }
.agent-navigation .agent-page-selected { background-color: var(--agent-button); color: var(--agent-ink); border-color: var(--agent-line); }
.agent-navigation .agent-nav-icon { position: absolute; left: 10px; top: 8px; width: 17px; height: 17px; flex-shrink: 0; }
.agent-navigation .agent-page .unity-button__text { flex-grow: 1; min-width: 0; white-space: normal; }
.agent-sidebar-heading { margin: 16px 0 9px; font-size: 11px; color: var(--agent-muted); }
.agent-workspace .agent-main { padding: 0 20px 16px; min-width: 0; flex-grow: 1; }
.agent-header { min-height: 65px; flex-shrink: 0; align-items: center; border-bottom-width: 1px; border-bottom-color: var(--agent-line); }
.agent-header .card-title { flex-grow: 1; font-size: 16px; margin: 0; color: var(--agent-ink); }
.agent-header Button { margin: 0; background-color: transparent; }
.agent-workspace #agent-status { flex-shrink: 0; margin: 8px 0; color: var(--agent-muted); font-size: 12px; max-height: 48px; overflow: hidden; }
.agent-work-area { flex-grow: 1; flex-shrink: 1; min-height: 0; align-items: stretch; flex-wrap: nowrap; }
.agent-content-scroll { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.agent-content-scroll > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container { padding-right: 10px; padding-top: 16px; padding-bottom: 12px; }
.agent-workspace .description { color: var(--agent-muted); margin: 8px 0; font-size: 12px; white-space: normal; }
.agent-workspace .card-title { color: var(--agent-ink); }
.agent-workspace .unity-foldout { margin: 8px 0; color: var(--agent-ink); }
.agent-workspace .unity-foldout__toggle { color: var(--agent-muted); }
.agent-workspace .unity-foldout__text { color: var(--agent-muted); }
.agent-workspace .unity-foldout__content { margin-left: 0; padding-top: 8px; }
.agent-workspace .unity-base-field { flex-direction: column; margin: 0 0 10px; }
.agent-workspace .unity-base-field__label { min-width: 0; color: var(--agent-muted); margin-bottom: 6px; }
.agent-workspace .unity-base-field__input { min-width: 0; background-color: var(--agent-input); color: var(--agent-ink); border-color: var(--agent-line); }
.agent-workspace .unity-base-text-field__input { border-width: 1px; border-radius: 8px; padding: 8px 10px; min-height: 36px; }
.agent-workspace .unity-base-popup-field__input { padding: 6px 8px; min-height: 33px; border-width: 1px; border-radius: 8px; }
.agent-workspace .unity-base-popup-field__text { color: var(--agent-ink); }
.agent-workspace .unity-toggle { flex-direction: row-reverse; justify-content: flex-end; align-items: center; }
.agent-workspace .unity-foldout__toggle { flex-direction: row; }
.agent-workspace .unity-toggle__label { margin: 0 0 0 7px; }
.agent-workspace .unity-toggle__input { flex-grow: 0; min-width: 20px; min-height: 20px; flex-shrink: 0; }
.agent-workspace .unity-foldout__toggle > .unity-toggle__input { flex-grow: 1; min-width: 0; }
.agent-workspace .unity-foldout__text { flex-grow: 1; }
.agent-workspace .unity-toggle .unity-toggle__checkmark { width: 16px; height: 16px; border-width: 1px; border-color: var(--agent-muted); border-radius: 3px; }
.agent-workspace .unity-toggle:checked .unity-toggle__checkmark { background-color: var(--agent-accent); }
.agent-workspace .agent-composer { flex-shrink: 0; max-height: 48%; background-color: var(--agent-card); border-width: 1px; border-color: var(--agent-line); border-radius: 17px; padding: 12px 14px; margin-top: 10px; }
.agent-workspace #agent-goal { min-height: 68px; max-height: 160px; margin-bottom: 4px; }
.agent-workspace #agent-goal .unity-base-text-field__input { min-height: 68px; border-width: 0; background-color: transparent; font-size: 14px; padding: 6px 2px; }
.agent-workspace #agent-task-options { max-height: 180px; flex-shrink: 1; margin: 2px 0 8px; }
.agent-task-options-scroll { max-height: 155px; }
.agent-composer > .row { flex-shrink: 0; align-items: center; }
.agent-composer > .row .unity-base-field { margin: 0 6px 6px 0; }
.agent-workspace #agent-provider { width: 265px; max-width: 100%; min-width: 180px; flex-shrink: 0; }
.agent-workspace #agent-provider .unity-base-popup-field__text { white-space: normal; overflow: visible; text-overflow: clip; flex-grow: 1; flex-shrink: 1; min-width: 0; }
.agent-workspace #agent-provider .unity-base-popup-field__input { flex-wrap: nowrap; min-width: 0; }
.agent-workspace #agent-access { max-width: 175px; min-width: 130px; flex-shrink: 1; }
.agent-composer > .row Button { margin: 0 6px 6px 0; }
.agent-execution-mode { padding: 2px; margin-right: 6px; margin-bottom: 6px; border-radius: 18px; background-color: var(--agent-input); }
.agent-workspace .agent-execution-mode Button { background-color: transparent; border-width: 0; border-radius: 16px; padding: 4px 9px; min-height: 28px; margin: 0; font-size: 11px; }
.agent-workspace .agent-execution-mode .agent-mode-selected { background-color: var(--agent-accent); color: #102537; }
.light .agent-workspace .agent-execution-mode .agent-mode-selected { color: white; }
.agent-workspace .agent-primary { background-color: var(--agent-accent); color: #102537; border-color: var(--agent-accent); }
.light .agent-workspace .agent-primary { color: white; }
.agent-task-title { margin: 0 0 12px; padding: 16px 18px; font-size: 17px; background-color: var(--agent-card); border-radius: 12px; white-space: normal; }
.agent-task-controls { justify-content: flex-end; margin: 6px 0 12px; }
.agent-task-controls Button { background-color: transparent; font-size: 11px; min-height: 29px; }
.agent-user-message, .agent-assistant-message { margin: 0 0 10px; padding: 10px 14px; border-width: 1px; border-color: var(--agent-line); border-radius: 14px; background-color: var(--agent-card); color: var(--agent-ink); font-size: 14px; white-space: normal; }
.agent-user-message { margin-left: 12%; background-color: var(--agent-user); }
.agent-assistant-message { margin-right: 8%; }
.agent-empty-title { margin: 30px 0 8px; font-size: 20px; color: var(--agent-ink); }
.agent-inspector { width: 220px; flex-shrink: 0; border-left-width: 1px; border-left-color: var(--agent-line); margin-left: 10px; padding-left: 14px; }
.agent-inspector-value { font-size: 12px; color: var(--agent-ink); white-space: normal; }
.agent-process { font-size: 11px; color: var(--agent-muted); padding: 8px 0; border-bottom-width: 1px; border-bottom-color: var(--agent-line); white-space: normal; }
.agent-code { padding: 10px; margin-bottom: 8px; font-size: 12px; background-color: var(--agent-bg); color: var(--agent-ink); border-radius: 8px; white-space: normal; }
.agent-approval { border-width: 1px; border-color: var(--agent-accent); border-radius: 12px; background-color: var(--agent-card); padding: 14px; }
.agent-workspace .agent-approve { background-color: #204d40; color: #eafff5; border-color: #54ac8b; }
.agent-workspace .agent-reject { background-color: #552b42; color: #ffe3ea; }
.light .agent-workspace .agent-approve { background-color: #e2f4ea; color: #1d6b4f; }
.light .agent-workspace .agent-reject { background-color: #fbe7ec; color: #a33a55; }
.agent-history-result { margin: 8px 0; padding: 16px; border-width: 1px; border-color: var(--agent-line); border-radius: 12px; background-color: var(--agent-card); }
.agent-tight .agent-navigation { width: 174px; min-width: 140px; }
.agent-tight .agent-inspector { display: none; }
.agent-tight .agent-main { padding-left: 14px; padding-right: 14px; }
.agent-workspace .unity-scroller--vertical { width: 6px; }
.agent-workspace .unity-scroller__low-button, .agent-workspace .unity-scroller__high-button { display: none; }
