.studio { flex-grow: 1; background-color: #201b25; color: #f6eaf1; font-size: 14px; }
.header { height: 56px; flex-direction: row; align-items: center; padding-left: 20px; padding-right: 20px; background-color: #2d2432; border-bottom-width: 1px; border-bottom-color: #544150; }
.logo { width: 32px; height: 32px; margin-right: 10px; }
.brand { font-size: 21px; -unity-font-style: bold; }
.badge { margin-left: 14px; font-size: 10px; color: #ffc3de; background-color: #57404f; padding-left: 12px; padding-right: 12px; padding-top: 5px; padding-bottom: 5px; border-radius: 10px; }
.spacer { flex-grow: 1; }
.workspace { flex-grow: 1; flex-direction: row; padding: 18px; }
.dock { width: 175px; padding-top: 10px; margin-right: 18px; }
Button { min-height: 36px; background-color: #463440; color: #ffe2ef; border-width: 1px; border-color: #725364; border-radius: 10px; padding: 8px 12px; margin: 3px; }
Button:hover { background-color: #654456; border-color: #f39bbf; }
Button:focus { border-color: #ffc4df; border-width: 2px; }
.dock-button { margin-bottom: 9px; -unity-text-align: middle-left; background-color: #302632; white-space: normal; }
.dock-button.selected { background-color: #713e58; border-color: #eba3c0; }
.stage { flex-grow: 1; justify-content: center; align-items: center; margin-right: 18px; background-color: #28222e; border-radius: 24px; }
.stage-heading { font-size: 25px; color: #f5c4dc; margin: 10px; white-space: normal; -unity-text-align: middle-center; }
.stage-caption { font-size: 14px; color: #c8a9bd; }
.stage-note { max-width: 350px; margin: 16px; white-space: normal; -unity-text-align: middle-center; color: #d1bacc; }
.panel { width: 385px; background-color: #302632; border-width: 1px; border-color: #66505f; border-radius: 22px; overflow: hidden; }
.panel-header { flex-direction: row; align-items: center; padding: 18px; border-bottom-width: 1px; border-bottom-color: #66505f; }
.panel-title { flex-grow: 1; font-size: 22px; -unity-font-style: bold; }
.close { width: 34px; font-size: 20px; }
.panel-scroll { flex-grow: 1; padding: 14px; }
.card { padding: 14px; margin-bottom: 14px; border-width: 1px; border-color: #66505f; border-radius: 16px; background-color: #382c39; }
.card-title { font-size: 16px; -unity-font-style: bold; margin-bottom: 12px; white-space: normal; }
.description { color: #ddc5d5; white-space: normal; margin-top: 8px; margin-bottom: 14px; }
.row { flex-direction: row; align-items: center; }
TextField { margin-top: 8px; margin-bottom: 8px; }
TextField > .unity-text-field__input { background-color: #241e2b; color: #ffedf5; border-width: 1px; border-color: #876278; border-radius: 8px; min-height: 32px; padding: 6px; }
.search { margin-bottom: 12px; }
.catalog-results { max-height: 470px; }
.model-row { margin-top: 8px; }
.model-row Button { -unity-text-align: middle-left; white-space: normal; }
.model-path { white-space: normal; color: #cab0c1; font-size: 11px; margin: 3px 9px 9px 9px; }
.chat { position: absolute; bottom: 16px; left: 16px; width: 335px; max-height: 300px; padding: 14px; background-color: #302632; border-width: 1px; border-color: #725364; border-radius: 18px; }
.messages { max-height: 170px; }
.message { white-space: normal; padding: 10px; margin-bottom: 8px; background-color: #453341; border-radius: 12px; }
.user-message { white-space: normal; padding: 10px; margin-bottom: 8px; background-color: #6a3d56; border-radius: 12px; }
.chat-input { flex-grow: 1; width: 100px; }
.footer { height: 56px; flex-direction: row; align-items: center; padding-left: 20px; padding-right: 20px; background-color: #2d2432; }
.status { flex-grow: 1; font-size: 12px; white-space: normal; margin-right: 12px; }
.compact .dock { width: 125px; margin-right: 8px; }
.compact .panel { width: 320px; }
.compact .stage { margin-right: 8px; }
.compact .chat { width: 240px; }
.light { background-color: #f6edf2; color: #493443; }
.light .header, .light .footer, .light .panel, .light .chat { background-color: #fff9fc; }
.light .stage { background-color: #eee3ed; }
.light .card { background-color: #fffafd; border-color: #dcc1d1; }
.light Button { background-color: #f7e1ed; color: #793856; border-color: #d8b4c7; }
.light Button:hover, .light .dock-button.selected { background-color: #ecc4d8; }
.light .description, .light .model-path, .light .stage-note, .light .stage-caption { color: #76576d; }
.light .stage-heading { color: #9c476e; }
.light .message { background-color: #f2e2ed; }
.light .user-message { background-color: #eac9db; }
.light TextField > .unity-text-field__input { background-color: #ffffff; color: #493443; }
