.studio { --card:#20242b; --wash:#171b21; --input:#292f38; --ink:#edf1f7; --muted:#b5c1d0; --line:#414b59; --button:#303c4b; --accent:#91ceff; --stage:#11151a; flex-grow:1; background-color:var(--stage); color:var(--ink); font-size:13px; }
.studio.light { --card:#fff; --wash:#edf2f8; --input:#f0f4fa; --ink:#27364b; --muted:#526279; --line:#d8e3ee; --button:#e9f4fb; --accent:#075f8a; --stage:#e6ebf1; }
.studio.window-transparent { background-color:rgba(0,0,0,0); }
.quick-controls, .quick-settings { display:none; }
.compact .quick-controls { display:flex; position:absolute; right:12px; bottom:12px; flex-direction:row; }
.quick-controls Button { width:46px; height:46px; min-height:46px; border-radius:23px; padding:0; margin-left:8px; -unity-text-align:middle-center; }
.compact .quick-settings { display:flex; position:absolute; right:12px; top:12px; width:34px; height:34px; min-height:34px; border-radius:17px; padding:0; align-items:center; justify-content:center; }
.vtuber .quick-controls, .vtuber .quick-settings, .agent .quick-controls, .agent .quick-settings { display:none; }
.microphone-active { border-width:3px; border-color:#f87171; background-color:var(--input); color:#f87171; }
.unity-label { white-space:normal; margin:0; padding:0; }
.studio .card-title { margin-bottom:12px; }
.studio .description { margin-top:10px; margin-bottom:10px; }
.studio .panel-edition { margin-bottom:3px; }
.studio .stage-heading { margin:10px; }
.studio .stage-note { margin:16px; }
.header { position:absolute; top:0; left:0; right:0; height:42px; flex-direction:row; align-items:center; padding-left:16px; background-color:var(--card); border-bottom-width:1px; border-bottom-color:var(--line); }
.logo { width:23px; height:23px; margin-right:9px; }
.brand { font-size:16px; }
.badge { margin-left:9px; font-size:9px; color:var(--accent); background-color:var(--button); padding:3px 8px; border-radius:6px; }
.spacer { flex-grow:1; }
.window-controls { height:41px; flex-direction:row; }
.window-controls Button { height:41px; min-height:41px; width:44px; margin:0; border-width:0; border-radius:0; color:var(--ink); background-color:transparent; padding:0; }
.workspace { position:absolute; top:42px; bottom:0; left:0; right:0; }
.stage { position:absolute; top:0; bottom:0; left:0; right:0; justify-content:center; align-items:center; }
.stage-heading { font-size:22px; color:var(--muted); margin:10px; -unity-text-align:middle-center; }
.stage-caption { font-size:13px; color:var(--muted); }
.stage-note { max-width:350px; margin:16px; -unity-text-align:middle-center; color:var(--muted); }
.dock { position:absolute; left:18px; top:31px; bottom:86px; width:52px; overflow:visible; }
.unity-button { min-height:36px; background-color:var(--button); color:var(--accent); border-width:1px; border-color:var(--line); border-radius:8px; padding:8px 12px; margin:0; font-size:12px; -unity-font-style:bold; }
Button:hover, Button:focus { border-color:var(--accent); }
Button:disabled { opacity:.6; }
.dock-button { width:52px; height:52px; min-height:52px; flex-shrink:0; flex-direction:column; justify-content:center; align-items:center; padding:13px; border-width:1px; border-color:rgba(255,255,255,0.47); border-radius:26px; background-color:var(--dock-tint,#e4f4fd); margin-bottom:14px; color:var(--dock-ink,#3184bb); }
.dock-button:hover { border-color:rgba(255,255,255,0.85); }
.dock-button.selected { background-color:#ffffff; border-width:2px; border-color:rgba(22,143,213,0.42); }
.dock-button.dock-picture { padding:0; background-color:transparent; border-width:0; }
.dock-button.dock-picture.selected { background-color:transparent; border-width:2px; border-color:transparent; }
.dock-button.dock-picture.selected-picture { border-color:rgba(22,143,213,.65); }
.dock-icon.dock-picture-icon { width:52px; height:52px; }
.dock-tint-pink { --dock-tint:#f7dce8; --dock-ink:#b7688d; }
.dock-tint-blue { --dock-tint:#d9effb; --dock-ink:#3888b3; }
.dock-tint-green { --dock-tint:#e3f3da; --dock-ink:#76a85c; }
.dock-tint-indigo { --dock-tint:#dce7fa; --dock-ink:#6480b5; }
.dock-tint-orange { --dock-tint:#fae8d1; --dock-ink:#b9894a; }
.dock-tint-purple { --dock-tint:#e9e2fa; --dock-ink:#8d6abb; }
.dock-tint-slate { --dock-tint:#e6ecf7; --dock-ink:#5a76a8; }
.dock-tint-periwinkle { --dock-tint:#e2e4fa; --dock-ink:#797cb0; }
.dock-tint-lock { --dock-tint:#fff0b8; --dock-ink:#9c7a16; }
.dock-tint-hide { --dock-tint:#e8edf7; --dock-ink:#61718c; }
.dock-lock { margin-top:4px; }
.dock-hide { margin-bottom:0; }
.dock-hover-label { position:absolute; left:64px; top:50%; translate:0 -50%; display:none; background-color:var(--card); color:var(--ink); padding:7px 12px; border-radius:8px; white-space:nowrap; font-size:13px; -unity-font-style:bold; }
.dock-icon { width:22px; height:22px; flex-shrink:0; }
.dock-scroll { flex-grow:1; min-height:0; }
.dock-scroll .unity-scroll-view__content-viewport { width:100%; }
.dock-scroll .unity-scroller { display:none; }
.dock-scroll .unity-scroll-view__content-container { align-items:center; }
.vtuber .footer { right:20px; }
.vtuber .footer .status { max-width:450px; }
.panel { position:absolute; width:410px; top:20px; bottom:12px; right:20px; background-color:var(--wash); border-width:1px; border-color:var(--line); border-top-left-radius:16px; border-top-right-radius:16px; border-bottom-left-radius:16px; border-bottom-right-radius:16px; overflow:hidden; padding-bottom:22px; }
.panel-header { flex-direction:row; align-items:center; padding:18px 19px 14px 19px; border-bottom-width:1px; border-bottom-color:var(--line); background-color:var(--card); flex-shrink:0; }
.panel-titles { flex-grow:1; }
.panel-edition { color:var(--accent); font-size:10px; -unity-font-style:bold; margin-bottom:3px; }
.panel-title { font-size:21px; flex-grow:1; }
.close { width:30px; height:30px; min-height:30px; padding:0; border-radius:15px; background-color:var(--input); color:var(--muted); -unity-text-align:middle-center; align-items:center; justify-content:center; }
.close.close-accent { background-color:var(--input); border-color:#3a4a60; }
.close-icon { width:9px; height:9px; flex-shrink:0; }
.panel-gear { width:20px; height:20px; margin-right:10px; flex-shrink:0; -unity-background-image-tint-color:var(--muted); }
.panel-scroll { flex-grow:1; padding:14px; }
.card { padding:16px; margin-bottom:12px; border-width:1px; border-color:var(--line); border-top-left-radius:12px; border-top-right-radius:12px; border-bottom-right-radius:12px; border-bottom-left-radius:12px; background-color:var(--card); flex-shrink:0; }
.card-title { font-size:14px; -unity-font-style:bold; margin-bottom:12px; color:var(--ink); }
.section-title { font-size:13px; margin-bottom:10px; }
.description { color:var(--muted); font-size:12px; white-space:normal; margin-top:10px; margin-bottom:10px; }
.row { flex-direction:row; flex-wrap:wrap; align-items:center; }
.row Button { margin-right:8px; margin-bottom:8px; }
TextField { margin:0 0 10px 0; }
TextField > .unity-text-field__input { background-color:var(--input); color:var(--ink); border-width:1px; border-color:var(--line); border-radius:10px; min-height:36px; padding:8px 11px; font-size:13px; }
TextField > .unity-text-field__label { min-width:0; font-size:12px; color:var(--ink); }
.search { margin-bottom:12px; }
.model-select { width:100%; height:38px; margin-bottom:10px; -unity-text-align:middle-left; }
.search-results { max-height:200px; }
.model-row { margin-top:8px; }
.model-row Button { -unity-text-align:middle-left; white-space:normal; }
.model-path { white-space:normal; color:var(--muted); font-size:11px; margin:3px 9px 9px 9px; }
.chat { position:absolute; bottom:80px; left:90px; width:340px; height:520px; background-color:var(--card); border-width:1px; border-color:var(--line); border-top-left-radius:20px; border-top-right-radius:20px; border-bottom-right-radius:20px; border-bottom-left-radius:6px; overflow:hidden; }
.chat-header { flex-direction:row; align-items:center; padding:13px 14px; flex-shrink:0; border-bottom-width:1px; border-bottom-color:var(--line); }
.chat-title { font-size:14px; -unity-font-style:bold; color:var(--accent); }
.chat-title-row { flex-direction:row; align-items:center; }
.chat-title-icon { width:16px; height:16px; margin-right:7px; flex-shrink:0; }
.chat-header Button { min-height:26px; height:26px; width:30px; padding:0; margin-left:5px; align-items:center; justify-content:center; }
.chat-header Button Image { width:16px; height:16px; }
.capture-status { font-size:11px; color:var(--muted); padding:6px 14px; border-bottom-width:1px; border-bottom-color:var(--line); flex-shrink:0; }
.messages { flex-grow:1; padding:12px; }
.message { padding:10px; margin-bottom:8px; background-color:var(--input); border-top-left-radius:14px; border-top-right-radius:14px; border-bottom-right-radius:14px; border-bottom-left-radius:4px; }
.user-message { padding:10px; margin-bottom:8px; background-color:var(--button); border-top-left-radius:14px; border-top-right-radius:14px; border-bottom-left-radius:14px; border-bottom-right-radius:4px; }
.composer { flex-direction:row; align-items:center; padding:10px 12px; border-top-width:1px; border-top-color:var(--line); flex-shrink:0; }
.composer Button { width:30px; min-width:30px; height:30px; min-height:30px; padding:0; align-items:center; justify-content:center; margin:0 1px; flex-shrink:0; }
.composer Button Image { width:16px; height:16px; }
.chat-input { flex-grow:1; flex-shrink:1; width:150px; min-width:60px; margin:0 4px; overflow:hidden; }
.chat-input > .unity-text-field__input { min-width:0; }
.chat-input .unity-text-field__input { --unity-cursor-color: #e9f3ff; --unity-selection-color: rgba(69, 145, 203, 0.55); }
.chat.minimized { height:54px; }
.chat.minimized .messages, .chat.minimized .capture-status, .chat.minimized .composer { display:none; }
.footer { position:absolute; bottom:14px; left:90px; right:392px; flex-direction:row; align-items:center; }
.footer Button { margin-left:8px; border-radius:20px; min-height:34px; flex-shrink:0; color:var(--accent); }
.status { font-size:12px; color:var(--muted); padding:7px 13px; background-color:var(--card); border-width:1px; border-color:var(--line); border-radius:20px; flex-shrink:1; max-height:90px; overflow:hidden; }
.short .dock { top:20px; bottom:70px; width:43px; }
.short .dock-button { width:43px; height:43px; min-height:43px; padding:10px; border-radius:22px; margin-bottom:8px; }
.compact .dock { left:10px; width:44px; }
.compact .dock-button { width:44px; height:44px; min-height:44px; padding:10px; border-radius:22px; }
.short .dock-icon, .compact .dock-icon { width:20px; height:20px; }
.short .dock-icon.dock-picture-icon { width:43px; height:43px; }
.compact .dock-icon.dock-picture-icon { width:44px; height:44px; }
.short .panel { top:13px; }
.compact .panel { width:auto; left:84px; right:10px; bottom:300px; }
.compact .chat { left:74px; width:270px; bottom:170px; }
.compact .footer { left:74px; right:12px; bottom:70px; flex-wrap:wrap; }
.compact .footer .status { width:100%; flex-basis:100%; max-height:34px; margin-bottom:6px; white-space:nowrap; text-overflow:ellipsis; }
.compact .footer Button { min-height:30px; padding:6px 8px; margin:0 6px 4px 0; font-size:11px; }
.compact.vtuber .panel { bottom:160px; }
.compact.vtuber .footer { right:10px; bottom:14px; }
.controls-hidden .quick-controls, .controls-hidden .quick-settings { display:none; }
.picker-overlay { position:absolute; top:42px; bottom:0; left:0; right:0; background-color:rgba(0,0,0,.45); align-items:center; justify-content:center; }
.picker-window { width:780px; max-width:95%; height:80%; background-color:var(--card); border-width:1px; border-color:var(--line); border-radius:20px; padding:20px; }
.picker-results { flex-grow:1; }
.picker-grid, .cloud-grid { flex-direction:row; flex-wrap:wrap; }
.picker-item { width:140px; height:120px; margin:6px; white-space:normal; }
.cloud-folder { width:45%; min-height:110px; margin:4px; white-space:normal; }
.cloud-character { width:45%; padding:8px; margin:4px; border-width:1px; border-color:var(--line); border-radius:12px; }
.controls-hidden .header, .controls-hidden .dock, .controls-hidden .panel, .controls-hidden .footer, .controls-hidden .chat { display:none; }
.panel.panel-closed { display:none; }
.controls-hidden .workspace { top:0; }
.vtuber.controls-hidden .chat { display:none; }
.stage-heading, .stage-caption, .stage-note { display:none; }
.panel-edition { height:14px; letter-spacing:1.44px; }
.panel-scroll .unity-scroller--vertical { width:6px; }
.panel-scroll .unity-scroller__low-button, .panel-scroll .unity-scroller__high-button { display:none; }
.panel-scroll .unity-scroller .unity-slider__tracker { background-color:transparent; border-width:0; }
.panel-scroll .unity-scroller .unity-slider__dragger { background-color:var(--line); border-width:0; border-radius:4px; }
.panel-scroll .unity-scroller { overflow:hidden; }
.panel-scroll .unity-scroller__slider, .panel-scroll .unity-scroller .unity-base-slider__input, .panel-scroll .unity-scroller .unity-base-slider__drag-container { width:6px; min-width:6px; margin:0; padding:0; }
.panel-scroll .unity-scroller .unity-base-slider__tracker { width:6px; background-color:transparent; border-width:0; }
.panel-scroll .unity-scroller .unity-base-slider__dragger { width:6px; min-width:6px; background-image:none; background-color:var(--line); border-width:0; border-radius:4px; }
.model-select { flex-direction:row; align-items:center; justify-content:space-between; }
.model-select-label { flex-grow:1; }
.model-select-arrow { width:12px; -unity-text-align:middle-right; }
.size-row { flex-direction:row; align-items:center; min-height:34px; margin:4px 0 14px 0; }
.size-row .size-label { width:42px; flex-shrink:0; color:var(--ink); font-size:12px; }
.size-row .sakura-slider { flex-grow:1; height:28px; margin-left:10px; margin-right:12px; }
.size-row .size-value { min-width:46px; flex-shrink:0; color:var(--ink); font-size:12px; -unity-font-style:bold; -unity-text-align:middle-right; }
.size-row .unity-base-slider__input, .size-row .unity-base-slider__drag-container { height:28px; }
.size-row .unity-base-slider__tracker { height:6px; background-color:var(--line); border-width:0; border-radius:999px; overflow:hidden; }
.size-row .sakura-slider-fill { background-color:var(--accent); border-radius:999px; }
.size-row .unity-base-slider__dragger { width:18px; height:18px; margin-top:-6px; background-image:none; background-color:#f8fcff; border-width:3px; border-color:var(--accent); border-radius:9px; }
.size-row .unity-base-slider__dragger:hover { background-color:#ffffff; }
.size-row .unity-base-slider__dragger:active { background-color:var(--accent); border-color:#ffffff; }
.size-row .sakura-slider:focus .unity-base-slider__dragger { border-color:#ffffff; }
.size-row .unity-base-slider__dragger-border { border-width:0; }
.resize-handle { position:absolute; background-color:var(--button); border-radius:5px; color:var(--accent); font-size:11px; padding:0; margin:0; -unity-text-align:middle-center; }
.resize-top { width:64px; height:22px; left:50%; translate:-50% 0; top:0; border-top-left-radius:0; border-top-right-radius:0; border-bottom-left-radius:8px; border-bottom-right-radius:8px; }
.resize-bottom { left:8px; right:8px; width:auto; height:18px; bottom:0; border-radius:9px; }
.resize-left, .resize-right { width:10px; height:36px; top:47%; }
.resize-left { left:0; }
.resize-right { right:0; }
.cloud-library TextField { flex-direction:column; }
.cloud-library { min-width:0; flex-shrink:1; }
.cloud-library .description, .cloud-library Label { white-space:normal; overflow:visible; }
.cloud-library .unity-foldout__toggle { min-width:0; white-space:normal; }
.cloud-library .unity-foldout__text { min-width:0; flex-shrink:1; white-space:normal; overflow:visible; }
.cloud-library .cloud-toggle { flex-direction:row; align-items:flex-start; min-width:0; white-space:normal; }
.cloud-library .cloud-toggle .unity-toggle__text { min-width:0; flex-shrink:1; white-space:normal; overflow:visible; }
.cloud-library .row { min-width:0; flex-wrap:wrap; }
.cloud-library Button { flex-shrink:1; white-space:normal; }
.cloud-library .unity-text-field__label { margin-bottom:6px; }
.cloud-library .unity-text-field__input { min-height:36px; }
.settings-tabs { flex-shrink:0; margin-bottom:14px; }
.settings-tabs Button { margin-right:4px; }
.settings-tabs .tab-selected { background-color:var(--button); border-radius:10px; }
.panel .unity-base-field { flex-direction:column; margin-bottom:12px; }
.panel .unity-base-field__label { margin-bottom:6px; min-width:0; }
.panel .unity-base-text-field__input { min-height:36px; padding:8px 11px; border-width:1px; border-color:var(--line); border-radius:8px; background-color:var(--input); color:var(--ink); }
.panel .unity-foldout__toggle { color:var(--muted); margin-top:8px; }
.panel .unity-foldout__content { margin-left:0; }
.panel .unity-foldout__text { color:var(--muted); }
.confirmation-card { width:410px; max-width:90%; padding:22px; border-width:1px; border-color:var(--line); border-radius:20px; background-color:var(--card); }
.conversation-switch { flex-direction:row; align-items:center; }
.conversation-switch .switch-track { width:34px; height:18px; border-radius:10px; background-color:var(--muted); margin:0 8px; padding:3px; }
.conversation-switch .switch-thumb { width:12px; height:12px; border-radius:6px; background-color:var(--ink); }
.conversation-switch.mode-active .switch-track { background-color:var(--accent); align-items:flex-end; }
.conversation-switch.mode-active .switch-thumb { background-color:var(--card); }
.expression-card { border-width:1px; border-color:var(--line); border-radius:14px; padding:10px 12px; margin-bottom:12px; background-color:var(--card); }
.expression-card > .unity-foldout__toggle { flex-direction:row; min-height:34px; margin:0; padding:0; align-items:center; }
.expression-card > .unity-foldout__toggle > .unity-toggle__input { display:flex; flex-grow:1; min-width:0; background-color:transparent; border-width:0; padding:0; }
.expression-card .unity-foldout__checkmark { display:none; }
.panel .unity-foldout__input { flex-grow:1; }
.expression-card > .unity-foldout__toggle .unity-toggle__text { flex-grow:1; margin:0; color:var(--ink); }
.expression-card .expression-expand { width:28px; height:28px; flex-shrink:0; margin-left:8px; border-radius:8px; border-width:1px; border-color:var(--line); background-color:var(--button); color:var(--accent); font-size:17px; -unity-text-align:middle-center; }
.expression-shortcut { color:var(--accent); font-size:11px; }
.expression-card .unity-foldout__text { color:var(--ink); white-space:normal; }
.expression-card > .unity-foldout__content { margin:12px 0 0; }
.status { white-space:nowrap; text-overflow:ellipsis; }
.panel .unity-toggle { flex-direction:row; }
.panel .unity-base-popup-field__input { min-height:38px; background-color:var(--input); border-width:1px; border-color:var(--line); border-radius:10px; padding:8px 12px; color:var(--ink); }
.panel .unity-base-popup-field__text { color:var(--ink); }
.panel .unity-base-popup-field__arrow { -unity-background-image-tint-color:var(--accent); }
.panel .unity-toggle__text { color:var(--ink); white-space:normal; flex-grow:1; flex-shrink:1; min-width:0; }
.settings-tabs .unity-scroller--horizontal { height:6px; }
.settings-tabs .unity-scroller__low-button, .settings-tabs .unity-scroller__high-button { display:none; }
.agent .dock, .agent .panel, .agent .footer { display:none; }
.agent .stage { right:auto; width:24%; }
.agent-workspace { position:absolute; left:24%; right:12px; top:12px; bottom:12px; flex-direction:row; border-width:1px; border-color:var(--line); border-radius:14px; background-color:var(--wash); }
.agent-navigation { width:200px; flex-shrink:0; background-color:var(--card); border-right-width:1px; border-color:var(--line); padding:16px 12px; }
.agent-navigation Button { margin-bottom:5px; white-space:normal; -unity-text-align:middle-left; }
.agent-task-row { font-size:11px; max-height:68px; overflow:hidden; }
.agent-main { flex-grow:1; flex-shrink:1; min-width:220px; padding:16px; }
.agent-main .card { padding:12px; margin:8px 0 0 0; }
.agent-main .unity-base-field { flex-direction:column; margin-bottom:8px; }
.agent-main .unity-base-field__label { color:var(--ink); min-width:0; margin-bottom:4px; }
.agent-main .unity-base-popup-field__input { background-color:var(--input); color:var(--ink); min-height:32px; }
.agent-main .unity-base-popup-field__text { color:var(--ink); }
.agent-main .unity-toggle { flex-direction:row; }
.agent-main TextField { max-height:86px; }
.agent-main .unity-foldout { margin:10px 0; }
.compact .agent-workspace { left:0; }
.compact .agent-navigation { width:120px; padding:6px; }
.mobile-header { flex-direction: row; justify-content: space-between; align-items: center; padding: 12px; }
.mobile-chat { height: 35%; min-height: 220px; padding: 10px; background-color: var(--card); }
.mobile-settings { position: absolute; left: 8px; right: 8px; top: 8px; bottom: 8px; padding: 18px; background-color: var(--card); border-radius: 18px; }
.mobile-settings Label { white-space: normal; margin-bottom: 10px; }
.mobile-settings Button { margin-top: 8px; margin-bottom: 8px; min-height: 40px; }
.mobile-settings TextField, .mobile-settings DropdownField { margin-bottom: 12px; }
.model-settings-open .panel-scroll { padding:0; }
.model-settings-open .panel-header { padding:20px; }
.model-zoom { flex-direction:row; align-items:center; padding:12px 16px; border-bottom-width:1px; border-bottom-color:var(--line); background-color:var(--card); }
.model-zoom > Label { margin-right:8px; }
.model-zoom Button { min-width:34px; min-height:36px; margin-right:8px; padding:6px 10px; }
.model-zoom IntegerField { width:84px; margin:0 8px 0 0; }
.model-zoom .unity-base-field__input { background-color:var(--input); color:var(--ink); border-width:1px; border-color:var(--line); border-radius:8px; padding:8px 11px; }
.model-tabs { flex-shrink:0; border-bottom-width:1px; border-bottom-color:var(--line); background-color:var(--card); }
.model-tab { width:88px; min-width:88px; height:50px; min-height:50px; white-space:normal; font-size:10px; border-width:0 1px 2px 0; border-color:var(--line); border-bottom-color:transparent; border-radius:0; background-color:transparent; color:var(--muted); padding:8px 6px; -unity-text-align:middle-center; flex-shrink:0; }
.model-tab.tab-selected { color:var(--accent); background-color:var(--input); border-bottom-color:var(--accent); }
.model-tab-body { padding:20px; }
.model-tab-body Button { margin-bottom:8px; }
.model-tab-body > Label { white-space:normal; margin-bottom:14px; }
.model-tabs .unity-scroller--horizontal { height:6px; }
.model-tabs .unity-scroller__low-button, .model-tabs .unity-scroller__high-button { display:none; }
.colour-preview { height:42px; border-width:6px; border-radius:9px; border-color:var(--input); margin:10px 0 18px; }
.colour-picker-row { flex-direction:row; align-items:center; margin-bottom:18px; }
.colour-wheel { width:200px; height:200px; flex-shrink:0; }
.colour-marker { position:absolute; width:10px; height:10px; border-radius:5px; border-width:1px; border-color:white; background-color:transparent; }
.colour-rgb { flex-grow:1; min-width:65px; margin-left:12px; }
.colour-rgb .colour-channel { flex-direction:row; align-items:center; }
.colour-rgb .unity-base-field__label { min-width:16px; width:16px; margin-right:5px; }
.colour-rgb .unity-base-field__input { min-width:36px; background-color:var(--input); color:var(--ink); border-width:1px; border-color:var(--line); border-radius:7px; padding:6px; }
.model-tabs-three .unity-scroll-view__content-container { width:100%; }
.model-tabs-three .model-tab { width:auto; min-width:0; flex-grow:1; flex-basis:0; font-size:9px; padding:8px 3px; }
.settings-tabs .settings-tab { width:54px; min-width:54px; height:62px; min-height:62px; border-width:1px; border-color:transparent; border-radius:10px; background-color:transparent; font-size:9px; white-space:normal; padding:4px 2px; flex-direction:column; align-items:center; justify-content:center; }
.settings-tab Image { width:18px; height:18px; margin-bottom:3px; flex-shrink:0; }
.settings-tab Label { font-size:9px; white-space:normal; -unity-text-align:middle-center; color:var(--ink); }
.settings-tabs .settings-tab.tab-selected { background-color:#2b3543; border-color:#3b4859; border-bottom-width:2px; border-bottom-color:var(--accent); }
.settings-tab.tab-selected Label { color:var(--accent); }
.mode-active { border-color:var(--accent); background-color:var(--input); }
.panel .unity-toggle { flex-direction:row-reverse; justify-content:flex-end; }
.panel .unity-foldout__toggle { flex-direction:row; }
.panel .unity-toggle__label { margin:0 0 0 8px; flex-grow:1; flex-shrink:1; min-width:0; white-space:normal; }
.panel .unity-toggle__input { flex-grow:1; min-width:20px; min-height:20px; flex-shrink:1; }
.panel .unity-toggle .unity-toggle__checkmark { width:16px; height:16px; border-width:1px; border-color:var(--muted); border-radius:3px; background-color:var(--input); }
.panel .unity-toggle:checked .unity-toggle__checkmark { background-color:var(--accent); border-color:var(--accent); }
.panel .unity-foldout__toggle > .unity-toggle__input { flex-grow:1; min-width:0; }
.panel .unity-foldout__text { flex-grow:1; }
.panel .unity-base-slider__tracker { height:6px; background-color:var(--line); border-width:0; border-radius:999px; overflow:hidden; }
.panel .unity-base-slider__input, .panel .unity-base-slider__drag-container { min-height:24px; }
.sakura-slider-fill { position:absolute; left:0; top:0; bottom:0; background-color:var(--accent); border-radius:999px; }
.panel .unity-base-slider__dragger { width:16px; height:16px; margin-top:-5px; background-image:none; background-color:var(--accent); border-radius:8px; border-width:2px; border-color:var(--wash); }
.panel .unity-base-slider__dragger:hover { border-color:var(--ink); }
.panel .unity-base-slider__dragger:active { background-color:var(--ink); border-color:var(--accent); }
.panel .unity-base-slider__dragger-border { border-width:0; }
.icon-text-button { flex-direction:row; align-items:center; justify-content:center; }
.button-icon { width:16px; height:16px; margin-right:6px; flex-shrink:0; }
.splash { position:absolute; top:0; bottom:0; left:0; right:0; background-color:#090713; align-items:center; justify-content:center; flex-direction:column; }
.splash-logo { width:220px; height:220px; margin-bottom:18px; }
.splash-title { font-size:28px; -unity-font-style:bold; color:#ffffff; letter-spacing:1px; margin-bottom:18px; }
.splash-track { width:280px; height:5px; border-radius:3px; background-color:rgba(255,255,255,0.125); overflow:hidden; margin-bottom:18px; }
.splash-track-fill { width:126px; height:5px; border-radius:3px; background-color:#a7ceee; }
.splash-label { font-size:14px; color:#e7dfff; }
.voice-modal { position:absolute; top:0; bottom:0; left:0; right:0; background-color:rgba(0,0,0,0.45); align-items:center; justify-content:center; }
.voice-card { width:420px; max-width:90%; background-color:var(--card); border-width:1px; border-color:var(--line); border-radius:18px; overflow:hidden; }
.voice-card-header { padding:16px 20px 12px 20px; border-bottom-width:1px; border-bottom-color:var(--line); }
.voice-card-title { font-size:16px; -unity-font-style:bold; color:var(--ink); }
.voice-card-body { padding:18px 20px 20px 20px; }
.voice-message { color:var(--ink); white-space:normal; }
.voice-bar { height:7px; margin:16px 0 8px 0; border-radius:999px; background-color:rgba(255,255,255,0.1); overflow:hidden; }
.voice-bar-fill { width:100%; height:7px; border-radius:999px; background-color:var(--accent); }
.voice-hint { color:var(--muted); font-size:12px; white-space:normal; margin-top:8px; }
.voice-error { color:#f87171; font-size:12px; white-space:normal; margin-top:8px; }
.voice-close { display:none; margin-top:12px; align-self:flex-start; }

/* Startup experience chooser — port of launcher/StartupDialog.cs */
.startup-chooser { position:absolute; top:0; left:0; right:0; bottom:0; background-color:#0c0f1a; align-items:center; justify-content:center; z-index:200; }
.startup-card { width:620px; height:755px; min-width:620px; max-width:96%; max-height:96%; background-color:#0c0f1a; border-width:1px; border-color:#353f58; border-radius:16px; overflow:hidden; }
.startup-scroll { position:absolute; left:0; top:0; right:0; bottom:0; }
.startup-body { position:relative; padding:0; }
.startup-scroll .unity-scroll-view__content-container { padding:0; }
.startup-top { flex-direction:row; align-items:center; height:46px; margin-top:0; }
.startup-logo { width:22px; height:22px; margin-right:10px; }
.startup-brand { color:#919bb4; font-size:11px; -unity-font-style:bold; letter-spacing:1px; -unity-text-align:middle-left; }
.startup-close { width:42px; height:34px; min-height:34px; padding:0; margin:0; border-width:0; background-color:transparent; color:#919bb4; font-size:18px; -unity-text-align:middle-center; }
.startup-close:hover { background-color:#301c2c; color:#fff; border-width:0; }
.startup-line { height:2px; flex-direction:row; margin:0; overflow:hidden; }
.startup-eyebrow { color:#61e1eb; font-size:11px; -unity-font-style:bold; letter-spacing:1.4px; -unity-text-align:middle-left; }
.startup-title { color:#f2f5ff; font-size:34px; -unity-font-style:bold; -unity-text-align:middle-left; }
.startup-subtitle { color:#919bb4; font-size:13px; -unity-text-align:middle-left; }
.startup-key-label { color:#919bb4; font-size:10px; -unity-font-style:bold; letter-spacing:1px; -unity-text-align:middle-left; }
.startup-provider { width:268px; margin:0; }
.startup-provider .unity-base-popup-field__input { min-height:34px; background-color:#151b2c; border-width:1px; border-color:#303b52; border-radius:10px; padding:7px 12px; }
.startup-provider .unity-base-popup-field__text { color:#e6ecfa; font-size:12px; }
.startup-provider .unity-base-popup-field__arrow { -unity-background-image-tint-color:#919bb4; }
.startup-input { margin:0; }
.startup-input > .unity-text-field__input { min-height:42px; background-color:#151b2c; border-width:1px; border-color:#303b52; border-radius:10px; padding:9px 13px; color:#e6ecfa; font-size:13px; }
.startup-hint { color:#919bb4; font-size:10.5px; white-space:normal; -unity-text-align:middle-left; }
.startup-hint.startup-error { color:#ff97b1; }
.startup-model { width:195px; margin:0; }
.startup-model > .unity-text-field__input { min-height:30px; background-color:#151b2c; border-width:1px; border-color:#303b52; border-radius:10px; padding:5px 10px; color:#e6ecfa; font-size:12px; }
.startup-status { color:#ff97b1; font-size:10px; white-space:normal; -unity-text-align:middle-left; }
.startup-mode { height:76px; min-height:76px; flex-direction:row; align-items:center; padding:0 18px; margin:0; background-color:#171e2e; border-width:1px; border-color:#2c364c; border-radius:12px; }
.startup-mode:hover { background-color:#222b3f; border-color:#61e1eb; }
.startup-mode-cloud { border-width:2px; border-color:#61e1eb; }
.startup-mode-local:hover { border-color:#b499ff; }
.startup-mode-vtuber:hover { border-color:#f590c4; }
.startup-mode-icon-wrap { width:44px; height:44px; min-width:44px; border-radius:22px; background-color:rgba(97,225,235,.10); align-items:center; justify-content:center; margin-right:16px; }
.startup-mode-local .startup-mode-icon-wrap { background-color:rgba(180,153,255,.10); }
.startup-mode-vtuber .startup-mode-icon-wrap { background-color:rgba(245,144,196,.10); }
.startup-mode-icon { width:52px; height:52px; }
.startup-mode-copy { flex-grow:1; min-width:0; align-items:flex-start; justify-content:center; }
.startup-mode-title { color:#f0f4ff; font-size:18px; -unity-font-style:bold; -unity-text-align:middle-left; }
.startup-mode-description { color:#9aa6bd; font-size:12px; margin-top:1px; white-space:normal; -unity-text-align:middle-left; }
.startup-mode-tag { color:#61e1eb; font-size:10px; -unity-font-style:bold; letter-spacing:.8px; margin-right:10px; -unity-text-align:middle-right; }
.startup-mode-local .startup-mode-tag { color:#b499ff; }
.startup-mode-vtuber .startup-mode-tag { color:#f590c4; }
.startup-mode-arrow { color:#61e1eb; font-size:26px; -unity-font-style:bold; width:18px; -unity-text-align:middle-right; }
.startup-mode-local .startup-mode-arrow { color:#b499ff; }
.startup-mode-vtuber .startup-mode-arrow { color:#f590c4; }
.startup-footer { color:#cdd5e8; font-size:12px; white-space:normal; -unity-text-align:top-left; }
.startup-link { min-height:24px; height:24px; padding:0; margin:0; border-width:0; background-color:transparent; color:#61e1eb; font-size:11px; -unity-font-style:bold; -unity-text-align:middle-left; }
.startup-link:hover { color:#a871f4; border-width:0; }
.startup-note { color:#919bb4; font-size:10.5px; -unity-text-align:middle-left; }

/* Reference slider: blue filled track, light neutral remainder, large blue round thumb with a clean gap. */
.sakura-slider .sakura-slider-fill { background-color:#3d9bff; border-radius:999px; }
.sakura-slider-gap { position:absolute; top:0; bottom:0; background-color:var(--card); display:none; }
.panel .sakura-slider .unity-base-slider__tracker,
.size-row .sakura-slider .unity-base-slider__tracker { height:8px; background-color:#e6e6e6; border-width:0; border-radius:999px; overflow:hidden; }
.panel .sakura-slider .unity-base-slider__input,
.panel .sakura-slider .unity-base-slider__drag-container,
.size-row .sakura-slider .unity-base-slider__input,
.size-row .sakura-slider .unity-base-slider__drag-container { min-height:26px; height:26px; }
.panel .sakura-slider .unity-base-slider__dragger,
.size-row .sakura-slider .unity-base-slider__dragger { width:22px; height:22px; min-width:22px; min-height:22px; margin-top:-7px; background-image:none; background-color:#3d9bff; border-width:0; border-radius:11px; }
.panel .sakura-slider .unity-base-slider__dragger:hover,
.size-row .sakura-slider .unity-base-slider__dragger:hover { background-color:#238df8; border-width:0; }
.panel .sakura-slider .unity-base-slider__dragger:active,
.size-row .sakura-slider .unity-base-slider__dragger:active { background-color:#0d7ce8; border-width:0; }
.panel .sakura-slider .unity-base-slider__dragger-border,
.size-row .sakura-slider .unity-base-slider__dragger-border { border-width:0; }
.size-row .sakura-slider { height:26px; }
.size-row .sakura-slider .sakura-slider-fill { background-color:#3d9bff; }

/* Companion camera choices */
.camera-choices { flex-direction:row; flex-wrap:wrap; margin:4px 0 12px 0; }
.camera-choice { flex-grow:1; flex-basis:45%; min-width:150px; min-height:72px; margin:0 8px 8px 0; padding:12px 14px; border-width:1px; border-color:var(--line); border-radius:12px; background-color:var(--input); -unity-text-align:middle-left; white-space:normal; }
.camera-choice:hover { border-color:var(--accent); }
.camera-choice.camera-mode-active { border-color:#61e1eb; background-color:rgba(97,225,235,.10); }
.camera-choice-title { color:var(--ink); font-size:13px; -unity-font-style:bold; -unity-text-align:middle-left; }
.camera-choice-description { color:var(--muted); font-size:11px; margin-top:4px; white-space:normal; -unity-text-align:middle-left; }
