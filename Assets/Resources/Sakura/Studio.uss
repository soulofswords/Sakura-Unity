.studio { --card:#251b2d; --wash:#1c1423; --input:#302439; --ink:#fff0f8; --muted:#ccb6c8; --line:#4c354d; --button:#442b43; --accent:#ff9ec8; --stage:#120b18; flex-grow:1; background-color:var(--stage); color:var(--ink); font-size:13px; }
.studio.light { --card:#fffafc; --wash:#f9f0f5; --input:#fff; --ink:#493443; --muted:#785f70; --line:#e8d3df; --button:#f9e2ed; --accent:#a13464; --stage:#f5edf3; }
.unity-label { white-space:normal; margin:0; padding:0; }
.studio .card-title { margin-bottom:12px; }
.studio .description { margin-top:10px; margin-bottom:10px; }
.studio .panel-edition { margin-bottom:3px; }
.studio .stage-heading { margin:10px; }
.studio .stage-note { margin:16px; }
.header { position:absolute; top:0; left:0; right:0; height:42px; flex-direction:row; align-items:center; padding-left:16px; background-color:var(--card); border-bottom-width:1px; border-bottom-color:var(--line); }
.logo { width:23px; height:23px; margin-right:9px; }
.brand { font-size:16px; }
.badge { margin-left:9px; font-size:9px; color:var(--accent); background-color:var(--button); padding:3px 8px; border-radius:6px; }
.spacer { flex-grow:1; }
.window-controls { height:41px; flex-direction:row; }
.window-controls Button { height:41px; min-height:41px; width:44px; margin:0; border-width:0; border-radius:0; color:var(--ink); background-color:transparent; padding:0; }
.workspace { position:absolute; top:42px; bottom:0; left:0; right:0; }
.stage { position:absolute; top:0; bottom:0; left:0; right:0; justify-content:center; align-items:center; }
.stage-heading { font-size:22px; color:var(--muted); margin:10px; -unity-text-align:middle-center; }
.stage-caption { font-size:13px; color:var(--muted); }
.stage-note { max-width:350px; margin:16px; -unity-text-align:middle-center; color:var(--muted); }
.dock { position:absolute; left:12px; top:26px; bottom:94px; width:82px; padding:7px; border-width:1px; border-color:var(--line); border-radius:24px; background-color:var(--card); overflow:hidden; }
.unity-button { min-height:36px; background-color:var(--button); color:var(--accent); border-width:1px; border-color:var(--line); border-radius:10px; padding:8px 12px; margin:0; font-size:12px; -unity-font-style:bold; }
Button:hover, Button:focus { border-color:var(--accent); }
Button:disabled { opacity:.6; }
.dock-button { width:66px; height:62px; min-height:62px; flex-shrink:0; flex-direction:column; justify-content:center; align-items:center; padding:6px 3px; border-color:transparent; border-radius:15px; background-color:transparent; margin-bottom:4px; color:var(--muted); }
.dock-button.selected, .dock-button:hover { background-color:var(--button); border-color:var(--line); color:var(--accent); }
.dock-icon { width:22px; height:22px; flex-shrink:0; margin-bottom:4px; }
.dock-label { width:62px; font-size:10px; -unity-font-style:normal; -unity-text-align:middle-center; }
.panel { position:absolute; width:410px; top:20px; bottom:12px; right:20px; background-color:var(--wash); border-width:1px; border-color:var(--line); border-top-left-radius:22px; border-top-right-radius:22px; border-bottom-left-radius:16px; border-bottom-right-radius:16px; overflow:hidden; padding-bottom:22px; }
.panel-header { flex-direction:row; align-items:center; padding:21px 20px 18px 20px; border-bottom-width:1px; border-bottom-color:var(--line); background-color:var(--card); flex-shrink:0; }
.panel-titles { flex-grow:1; }
.panel-edition { color:var(--accent); font-size:9px; -unity-font-style:bold; margin-bottom:3px; }
.panel-title { font-size:22px; flex-grow:1; }
.close { width:30px; height:30px; min-height:30px; padding:0; background-color:var(--input); color:var(--muted); }
.panel-scroll { flex-grow:1; padding:14px; }
.card { padding:18px; margin-bottom:14px; border-width:1px; border-color:var(--line); border-top-left-radius:16px; border-top-right-radius:16px; border-bottom-right-radius:16px; border-bottom-left-radius:5px; background-color:var(--card); flex-shrink:0; }
.card-title { font-size:14px; -unity-font-style:bold; margin-bottom:12px; color:var(--ink); }
.section-title { font-size:13px; margin-bottom:10px; }
.description { color:var(--muted); font-size:12px; white-space:normal; margin-top:10px; margin-bottom:10px; }
.row { flex-direction:row; flex-wrap:wrap; align-items:center; }
.row Button { margin-right:8px; margin-bottom:8px; }
TextField { margin:0 0 10px 0; }
TextField > .unity-text-field__input { background-color:var(--input); color:var(--ink); border-width:1px; border-color:var(--line); border-radius:10px; min-height:36px; padding:8px 11px; font-size:13px; }
TextField > .unity-text-field__label { min-width:0; font-size:12px; color:var(--ink); }
.search { margin-bottom:12px; }
.model-select { width:100%; height:38px; margin-bottom:10px; -unity-text-align:middle-left; }
.search-results { max-height:200px; }
.model-row { margin-top:8px; }
.model-row Button { -unity-text-align:middle-left; white-space:normal; }
.model-path { white-space:normal; color:var(--muted); font-size:11px; margin:3px 9px 9px 9px; }
.chat { position:absolute; bottom:70px; left:90px; width:340px; height:440px; background-color:var(--card); border-width:1px; border-color:var(--line); border-top-left-radius:20px; border-top-right-radius:20px; border-bottom-right-radius:20px; border-bottom-left-radius:6px; overflow:hidden; }
.chat-header { flex-direction:row; align-items:center; padding:13px 14px; flex-shrink:0; border-bottom-width:1px; border-bottom-color:var(--line); }
.chat-title { font-size:14px; -unity-font-style:bold; color:var(--accent); }
.chat-header Button { min-height:26px; height:26px; width:30px; padding:0; margin-left:5px; }
.capture-status { font-size:11px; color:var(--muted); padding:6px 14px; border-bottom-width:1px; border-bottom-color:var(--line); flex-shrink:0; }
.messages { flex-grow:1; padding:12px; }
.message { padding:10px; margin-bottom:8px; background-color:var(--wash); border-top-left-radius:14px; border-top-right-radius:14px; border-bottom-right-radius:14px; border-bottom-left-radius:4px; }
.user-message { padding:10px; margin-bottom:8px; background-color:var(--button); border-top-left-radius:14px; border-top-right-radius:14px; border-bottom-left-radius:14px; border-bottom-right-radius:4px; }
.composer { flex-direction:row; align-items:center; padding:10px 12px; border-top-width:1px; border-top-color:var(--line); flex-shrink:0; }
.composer Button { width:38px; padding:0; }
.chat-input { flex-grow:1; min-width:0; margin:0 6px; }
.chat-input > .unity-text-field__input { min-width:0; }
.chat.minimized { height:54px; }
.chat.minimized .messages, .chat.minimized .capture-status, .chat.minimized .composer { display:none; }
.footer { position:absolute; bottom:14px; left:90px; right:392px; flex-direction:row; align-items:center; }
.footer Button { margin-left:8px; border-radius:10px; min-height:34px; flex-shrink:0; color:var(--accent); }
.status { font-size:12px; color:var(--ink); padding:8px 12px; background-color:var(--card); border-width:1px; border-color:var(--line); border-radius:10px; flex-shrink:1; max-height:90px; overflow:hidden; }
.short .dock, .compact .dock { width:60px; padding:5px; top:20px; bottom:110px; border-radius:19px; }
.short .dock-button, .compact .dock-button { width:48px; height:46px; min-height:46px; padding:8px; }
.short .dock-label, .compact .dock-label { display:none; }
.short .panel { top:13px; }
.compact .panel { width:auto; left:84px; right:10px; }
.compact .chat { left:74px; width:270px; }
.compact .footer { left:74px; right:10px; flex-wrap:wrap; }
.picker-overlay { position:absolute; top:42px; bottom:0; left:0; right:0; background-color:rgba(0,0,0,.45); align-items:center; justify-content:center; }
.picker-window { width:780px; max-width:95%; height:80%; background-color:var(--card); border-width:1px; border-color:var(--line); border-radius:20px; padding:20px; }
.picker-results { flex-grow:1; }
.picker-grid, .cloud-grid { flex-direction:row; flex-wrap:wrap; }
.picker-item { width:140px; height:120px; margin:6px; white-space:normal; }
.cloud-folder { width:45%; min-height:110px; margin:4px; white-space:normal; }
.cloud-character { width:45%; padding:8px; margin:4px; border-width:1px; border-color:var(--line); border-radius:12px; }
.controls-hidden .header, .controls-hidden .dock, .controls-hidden .panel, .controls-hidden .footer { display:none; }
.panel.panel-closed { display:none; }
.controls-hidden .workspace { top:0; }
.vtuber.controls-hidden .chat { display:none; }
.stage-heading, .stage-caption, .stage-note { display:none; }
.panel-edition { height:14px; letter-spacing:1.44px; }
.panel-scroll .unity-scroller--vertical { width:6px; }
.panel-scroll .unity-scroller__low-button, .panel-scroll .unity-scroller__high-button { display:none; }
.panel-scroll .unity-scroller .unity-slider__tracker { background-color:transparent; border-width:0; }
.panel-scroll .unity-scroller .unity-slider__dragger { background-color:var(--line); border-width:0; border-radius:4px; }
.panel-scroll .unity-scroller { overflow:hidden; }
.panel-scroll .unity-scroller__slider, .panel-scroll .unity-scroller .unity-base-slider__input, .panel-scroll .unity-scroller .unity-base-slider__drag-container { width:6px; min-width:6px; margin:0; padding:0; }
.panel-scroll .unity-scroller .unity-base-slider__tracker { width:6px; background-color:transparent; border-width:0; }
.panel-scroll .unity-scroller .unity-base-slider__dragger { width:6px; min-width:6px; background-image:none; background-color:var(--line); border-width:0; border-radius:4px; }
.model-select { flex-direction:row; align-items:center; justify-content:space-between; }
.model-select-label { flex-grow:1; }
.model-select-arrow { width:12px; -unity-text-align:middle-right; }
.size-row { flex-direction:row; align-items:center; margin-bottom:10px; }
.size-row .unity-slider { flex-grow:1; margin-left:8px; margin-right:8px; }
.size-row .unity-base-slider__dragger { width:15px; height:15px; background-image:none; border-radius:8px; background-color:var(--accent); border-width:0; }
.resize-handle { position:absolute; background-color:var(--button); border-radius:5px; color:var(--accent); font-size:11px; padding:0; margin:0; }
.resize-top, .resize-bottom { width:60px; height:10px; left:42%; -unity-text-align:middle-center; }
.resize-top { top:0; }
.resize-bottom { bottom:0; }
.resize-left, .resize-right { width:10px; height:44px; top:47%; -unity-text-align:middle-center; }
.resize-left { left:0; }
.resize-right { right:0; }
.cloud-library TextField { flex-direction:column; }
.cloud-library .unity-text-field__label { margin-bottom:6px; }
.cloud-library .unity-text-field__input { min-height:36px; }
.settings-tabs { flex-shrink:0; margin-bottom:14px; }
.settings-tabs Button { margin-right:4px; }
.settings-tabs .tab-selected { border-bottom-color:var(--accent); background-color:var(--input); }
.panel .unity-base-field { flex-direction:column; margin-bottom:12px; }
.panel .unity-base-field__label { margin-bottom:6px; min-width:0; }
.panel .unity-toggle { flex-direction:row; }
.panel .unity-base-popup-field__input { min-height:38px; background-color:var(--input); border-width:1px; border-color:var(--line); border-radius:10px; padding:8px 12px; color:var(--ink); }
.panel .unity-base-popup-field__text { color:var(--ink); }
.panel .unity-base-popup-field__arrow { -unity-background-image-tint-color:var(--accent); }
.panel .unity-toggle__text { color:var(--ink); white-space:normal; }
.settings-tabs .unity-scroller--horizontal { height:6px; }
.settings-tabs .unity-scroller__low-button, .settings-tabs .unity-scroller__high-button { display:none; }
